generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Записи о выдаче призов lootbox-промо: промокоды, deep-link и СБП-выплаты.
model ClaimRecord {
  id           String   @id @default(cuid())
  prizeId      String
  prizeTitle   String
  valueRub     Int
  category     String
  partnerName  String
  deliveryType String
  promoCode    String?
  phone        String?
  claimId      String
  status       String   @default("ISSUED")
  createdAt    DateTime @default(now())
}