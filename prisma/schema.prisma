// Prisma-схема промо-механики «Сканируй → задания → сундуки → подарки».

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Анонимный игрок (deviceId из localStorage / Telegram initData в будущем).
model Player {
  id        String   @id
  createdAt DateTime @default(now())

  scans  Scan[]
  chests Chest[]
  prizes PrizeRecord[]
}

// Один отсканированный код Честного знака. Уникален глобально:
// один код участвует в акции один раз (проверка «выбывший или нет»).
model Scan {
  id        Int      @id @default(autoincrement())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  code      String   @unique
  gtin      String
  serial    String
  flavorKey String
  lineKey   String
  createdAt DateTime @default(now())

  @@index([playerId])
}

// Сундук, выданный за выполненное задание (или из демо-панели).
model Chest {
  id            String      @id @default(cuid())
  playerId      String
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tier          String // BRONZE | SILVER | GOLD
  sourceQuestId String
  status        String      @default("UNOPENED") // UNOPENED | OPENED
  prizeId       String?     @unique
  prize         PrizeRecord? @relation(fields: [prizeId], references: [id])
  createdAt     DateTime    @default(now())
  openedAt      DateTime?

  @@index([playerId])
}

// Выпавший из сундука подарок (снапшот шаблона на момент выдачи).
model PrizeRecord {
  id           String   @id @default(cuid())
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  templateId   String
  tier         String
  title        String
  description  String
  valueRub     Int?
  partnerName  String
  deliveryType String // PROMO_CODE | DEEP_LINK | SBP_PAYOUT
  promoCode    String?
  instructions String // JSON-массив строк
  link         String
  linkLabel    String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  chests Chest[]

  @@index([playerId])
}
